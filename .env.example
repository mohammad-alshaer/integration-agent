# Copy this file to .env and fill in the values.
# .env is gitignored; .env.example is committed as a template.

# --- Google Gemini (primary LLM, free tier) ---
# Sign up: https://aistudio.google.com/  -> "Get API key" -> "Create API key in new project"
# Note: as of early 2026, free tier gives generous limits for gemini-2.5-flash but
# may not include gemini-2.5-pro. Start with flash; upgrade model once you have billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Langfuse (LLM observability, free tier: 50k observations/mo) ---
# Sign up: https://cloud.langfuse.com/  -> create project "integration-agent" -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Voyage (embeddings, free tier: 200M tokens, used starting M1 Week 3) ---
# Sign up: https://dash.voyageai.com/
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3-large

# --- SQL Server (local dev, Windows auth - no secrets) ---
# Instance + driver used by scripts/check_sqlserver.py and verify_adventureworks.py
SQLSERVER_INSTANCE=localhost\SQLDEV2025
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
